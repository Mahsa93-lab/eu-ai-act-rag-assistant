# Copy to .env and fill in. Never commit .env!

# --- LLM: any OpenAI-compatible endpoint -----------------------------------------------------------
# Default: OpenAI (LLM_BASE_URL empty). Key: https://platform.openai.com/api-keys
LLM_BASE_URL=
LLM_API_KEY=
# The smallest/cheapest current model – list the ids your key allows with:  python -m src.llm --list-models
CHAT_MODEL=
# Seconds between two calls (0 for paid keys; ~4 for free tiers)
LLM_MIN_INTERVAL_S=0
# Optional for reasoning models: none | minimal | low | medium | high  (low = faster and cheaper)
REASONING_EFFORT=
# Price of CHAT_MODEL in USD per 1 million tokens, from the provider's pricing page (for "cost per 100 questions")
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# Alternative 1 – Google Gemini API, free tier (key: https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MIN_INTERVAL_S=4
# Alternative 2 – local model without any API key (Ollama, https://ollama.com):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# CHAT_MODEL=qwen3:8b

# --- Embeddings: computed locally with fastembed (ONNX) ---------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# smaller/faster alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_CACHE=models
